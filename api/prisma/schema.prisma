generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  contacts      Contact[]
  agents        Agent[]
  messages      Message[]
  paymentLinks  PaymentLink[]
  payments      Payment[]
  webhookEvents WebhookEvent[]
  dailyMetrics  DailyMetric[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum Role {
  ADMIN
  VIEWER
}

model Contact {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  phone    String
  name     String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

model Agent {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  phone    String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  messages     Message[]
  dailyMetrics DailyMetric[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("agents")
}

model Message {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  waMessageId String           @unique @map("wa_message_id")
  direction   MessageDirection
  status      MessageStatus    @default(SENT)
  agentId     String?          @map("agent_id")
  contactId   String?          @map("contact_id")
  body        String?
  sentAt      DateTime?        @map("sent_at")
  deliveredAt DateTime?        @map("delivered_at")
  readAt      DateTime?        @map("read_at")
  failedAt    DateTime?        @map("failed_at")
  error       String?
  rawPayload  Json?            @map("raw_payload")
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  agent       Agent?       @relation(fields: [agentId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  paymentLink PaymentLink?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, agentId])
  @@map("messages")
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model PaymentLink {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  providerRef String            @unique @map("provider_ref")
  provider    String
  amount      Float
  currency    String            @default("INR")
  status      PaymentLinkStatus @default(CREATED)
  messageId   String?           @unique @map("message_id")
  sharedAt    DateTime?         @map("shared_at")
  paidAt      DateTime?         @map("paid_at")
  expiresAt   DateTime?         @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  message  Message?  @relation(fields: [messageId], references: [id])
  payments Payment[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("payment_links")
}

enum PaymentLinkStatus {
  CREATED
  SHARED
  PAID
  EXPIRED
  CANCELLED
}

model Payment {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  providerRef   String    @unique @map("provider_ref")
  paymentLinkId String?   @map("payment_link_id")
  amount        Float
  currency      String    @default("INR")
  status        String
  paidAt        DateTime? @map("paid_at")
  rawPayload    Json?     @map("raw_payload")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id])

  @@index([tenantId, createdAt])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  source      String
  eventId     String    @unique @map("event_id")
  rawPayload  Json      @map("raw_payload")
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([source, createdAt])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

model DailyMetric {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  date             DateTime @db.Date
  agentId          String?  @map("agent_id")
  messagesSent     Int      @default(0) @map("messages_sent")
  delivered        Int      @default(0)
  read             Int      @default(0)
  failed           Int      @default(0)
  replies          Int      @default(0)
  linksShared      Int      @default(0) @map("links_shared")
  paymentsReceived Int      @default(0) @map("payments_received")
  amountReceived   Float    @default(0) @map("amount_received")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent? @relation(fields: [agentId], references: [id])

  @@unique([tenantId, date, agentId])
  @@index([tenantId, date])
  @@map("daily_metrics")
}
