# App
NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://whatsapp:whatsapp@postgres:5432/whatsapp_monitor

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp (Meta Cloud API)
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Payment providers
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# Ingest API key (shared secret for CRM/agent tool)
INGEST_API_KEY=change-me-ingest-api-key

# Payment link detection regex (pipe-separated)
PAYMENT_LINK_PATTERNS=rzp\.io|razorpay\.com/pl_|pay\.cashfree\.com

# Prometheus (optional)
PROMETHEUS_ENABLED=true

# Log level
LOG_LEVEL=info
